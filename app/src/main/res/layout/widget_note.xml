<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:paddingStart="10dp"
        android:orientation="horizontal">
        <FrameLayout android:id="@+id/tab0" android:layout_width="26dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:background="@drawable/tab_on_0" android:visibility="gone" />
        <FrameLayout android:id="@+id/tab1" android:layout_width="26dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:background="@drawable/tab_on_0" android:visibility="gone" />
        <FrameLayout android:id="@+id/tab2" android:layout_width="26dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:background="@drawable/tab_on_0" android:visibility="gone" />
        <FrameLayout android:id="@+id/tab3" android:layout_width="26dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:background="@drawable/tab_on_0" android:visibility="gone" />
        <FrameLayout android:id="@+id/tab4" android:layout_width="26dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:background="@drawable/tab_on_0" android:visibility="gone" />
        <FrameLayout android:id="@+id/tab5" android:layout_width="26dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:background="@drawable/tab_on_0" android:visibility="gone" />
        <TextView android:id="@+id/tab_add"
            android:layout_width="22dp" android:layout_height="match_parent"
            android:background="@drawable/tab_add_bg"
            android:paddingTop="3dp" android:gravity="center"
            android:text="+" android:textSize="12sp" android:textStyle="bold"
            android:textColor="#88000000" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_0"
        android:padding="14dp">
        <TextView
            android:id="@+id/note_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Tap to write a note…"
            android:textColor="#99000000"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp"
            android:ellipsize="end" />
    </FrameLayout>
</LinearLayout>
